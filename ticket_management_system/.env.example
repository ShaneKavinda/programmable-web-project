POSTGRES_DB=flask_db
POSTGRES_USER=flask_user
POSTGRES_PASSWORD=change-me

SECRET_KEY=change-me
JWT_SECRET_KEY=change-me
ADMIN_API_KEY=change-me-admin-key

FLASK_APP=ticket_management_system.app:app
FLASK_ENV=production

# Local Docker Compose database:
DATABASE_URL=postgresql://flask_user:change-me@postgres:5432/flask_db

# AWS RDS example:
# DATABASE_URL=postgresql://flask_user:change-me@your-rds-endpoint.amazonaws.com:5432/flask_db

AUX_BOOKING_SWEEP_ENABLED=true
AUX_BOOKING_SWEEP_INTERVAL_SECONDS=600

# Keep this low on EC2 t2.micro/t3.micro.
GUNICORN_WORKERS=1
GUNICORN_THREADS=2
